{
  "note": "AMA's published API contract: the status vocabulary, the routes a client may call, and the shape of what those routes return. The server builds the document it serves at GET /api/contract from its own vocabulary and route table, and its suite asserts the served document matches this fixture — so a change to either surfaces as a test failure, not as a difference. A client fetches this document rather than assuming it, and keeps a vendored copy as its fallback. Changing this contract's content is a change to a public surface: bump `version` in the same commit, and update the client's vendored copy.",
  "version": "10",
  "statuses": {
    "vocabulary": ["needsInput", "working", "idle", "ended", "unknown"],
    "working": ["working"],
    "turnOver": ["ended", "idle", "needsInput"]
  },
  "routes": {
    "listSessions": { "method": "GET", "path": "/api/sessions", "shape": "sessionList" },
    "createSession": { "method": "POST", "path": "/api/sessions", "shape": "createdSession" },
    "reportEvent": { "method": "POST", "path": "/api/events", "shape": "eventAck" },
    "meshSessions": { "method": "GET", "path": "/api/mesh/sessions", "shape": "meshSnapshot" },
    "health": { "method": "GET", "path": "/api/health", "shape": "health" },
    "statusFeed": { "method": "WS", "path": "/ws/status", "shape": "statusFrame" },
    "capture": { "method": "GET", "path": "/api/sessions/{target}/capture", "shape": "capture" },
    "identity": { "method": "GET", "path": "/api/identity", "shape": "identity" },
    "targets": {"method":"GET","path":"/api/targets","shape":"targetList"},
    "promptSession": {"method":"POST","path":"/api/sessions/{name}/send","shape":"sendAck"},
    "promptPeerSession": {"method":"POST","path":"/api/proxy/{peerHost}/sessions/{name}/send","shape":"sendAck"},
    "agentMessage": {"method":"GET","path":"/api/sessions/{name}/message","shape":"agentMessageList"},
    "readPeerMessages": {"method":"GET","path":"/api/proxy/{peerHost}/sessions/{name}/message","shape":"agentMessageList"},
    "capturePeerSession": {"method":"GET","path":"/api/proxy/{peerHost}/sessions/{target}/capture","shape":"capture"},
    "setSessionGroup": {"method":"POST","path":"/api/sessions/{name}/group","shape":"sessionGroup"},
    "setSessionState": {"method":"POST","path":"/api/sessions/{name}/state","shape":"sessionState"}
  },
  "shapes": {
    "session": {
      "type": "object",
      "fields": {
        "name": { "type": "string" },
        "paneId": { "type": "string" },
        "tty": { "type": "string" },
        "currentCommand": { "type": "string" },
        "windowName": { "type": "string" },
        "status": { "type": "vocabulary" },
        "source": { "type": "string" },
        "agent": { "type": "string" },
        "lastActivity": { "type": "number" },
        "projectPath": { "type": "string", "optional": true },
        "summary": { "type": "string", "optional": true },
        "task": { "type": ["string", "null"], "optional": true },
        "group": { "type": ["string", "null"], "optional": true },
        "dir": { "type": ["string", "null"], "optional": true },
        "state": { "type": ["string", "null"], "optional": true }
      }
    },
    "sessionList": { "type": "array", "items": "session" },
    "createdSession": {
      "type": "object",
      "fields": {
        "ok": { "type": "boolean" },
        "name": { "type": "string" },
        "command": { "type": ["string", "null"] },
        "ownerToken": {"type":"string"}
      }
    },
    "eventAck": {
      "type": "object",
      "fields": {
        "ok": { "type": "boolean" },
        "target": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "event": { "type": "string" },
        "known": { "type": "boolean" },
        "status": { "type": ["vocabulary", "null"] },
        "source": { "type": ["string", "null"] },
        "changed": {"type":"boolean"},
        "messageId": {"type":["number","null"]},
        "task": {"type":["string","null"]}
      }
    },
    "meshSession": {
      "type": "object",
      "fields": {
        "name": { "type": "string" },
        "paneId": { "type": "string" },
        "tty": { "type": "string" },
        "currentCommand": { "type": "string" },
        "windowName": { "type": "string" },
        "status": { "type": "vocabulary" },
        "source": { "type": "string" },
        "agent": { "type": "string" },
        "lastActivity": { "type": "number" },
        "projectPath": { "type": "string", "optional": true },
        "summary": { "type": "string", "optional": true },
        "task": { "type": ["string", "null"], "optional": true },
        "group": { "type": ["string", "null"], "optional": true },
        "dir": { "type": ["string", "null"], "optional": true },
        "state": { "type": ["string", "null"], "optional": true },
        "machine": { "type": "string" },
        "machineHost": { "type": "string" }
      }
    },
    "meshSnapshot": {
      "type": "object",
      "fields": {
        "sessions": { "type": "array", "items": "meshSession" },
        "peerStatus": { "type": "object" }
      }
    },
    "health": {
      "type": "object",
      "fields": {
        "status": { "type": "string" },
        "ptyAllocation": { "type": "boolean" },
        "tmuxAccess": { "type": "boolean" },
        "spawnErrors": { "type": "number" },
        "uptimeMs": { "type": "number" },
        "pid": { "type": "number" }
      }
    },
    "statusFrame": {
      "type": "object",
      "fields": {
        "type": { "type": "string" },
        "sessions": { "type": "array", "items": "meshSession" },
        "peerStatus": { "type": "object" }
      }
    },
    "identity": {
      "type": "object",
      "fields": {
        "name": { "type": "string" },
        "peers": { "type": "array", "items": "peer" }
      }
    },
    "peer": {
      "type": "object",
      "fields": {
        "name": { "type": "string", "optional": true },
        "host": { "type": "string" },
        "port": { "type": "number" }
      }
    },
    "targetList": { "type": "array", "items": "target" },
    "target": {
      "type": "object",
      "fields": {
        "name": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "capture": {
      "type": "object",
      "fields": {
        "content": { "type": "string" },
        "status": { "type": "vocabulary" },
        "source": { "type": "string" }
      }
    },
    "agentMessage": {"type":"object","fields":{"id":{"type":"number"},"text":{"type":"string"},"at":{"type":"number"},"origin":{"type":["string","null"],"optional":true}}},
    "agentMessageList": {
      "type": "object",
      "fields": {
        "messages": {"type":"array","items":"agentMessage"}
      }
    },
    "sessionGroup": {
      "type": "object",
      "fields": {
        "ok": {"type":"boolean"},
        "name": {"type":"string"},
        "group": {"type":["string","null"]}
      }
    },
    "sessionState": {
      "type": "object",
      "fields": {
        "ok": {"type":"boolean"},
        "name": {"type":"string"},
        "state": {"type":["string","null"]}
      }
    },
    "sendAck": {
      "type": "object",
      "fields": {
        "ok": {"type":"boolean"},
        "name": {"type":"string"},
        "paneId": {"type":"string"}
      }
    }
  }
}
