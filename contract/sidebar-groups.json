{
  "description": "Shared contract for sidebar group sync. The web app (web/public/sidebar-sync.js) and the macOS app (Sources/AgentHub/Services/SidebarOrder.swift) must resolve every case below identically. Both test suites read this file: web/test/contract.test.js and Tests/AllMyAgentsTests/ContractTests.swift. A rule that changes on one side only fails the other side's suite, which is the whole point — the groups-protected rule was ported into the macOS app by hand, and the hand-port silently drifted.",
  "winnerCases": [
    {
      "name": "a copy with groups is not erased by a newer copy without them",
      "local": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 100 },
      "remote": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [] }, "updatedAt": 200 },
      "expected": "local"
    },
    {
      "name": "a copy without groups is not erased by an older copy with them",
      "local": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [] }, "updatedAt": 200 },
      "remote": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 100 },
      "expected": "remote"
    },
    {
      "name": "when both copies have groups, the newer one wins",
      "local": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 100 },
      "remote": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 200 },
      "expected": "remote"
    },
    {
      "name": "when both copies have groups, the older one loses",
      "local": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 200 },
      "remote": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 100 },
      "expected": "local"
    },
    {
      "name": "a blank copy never erases the server's groups",
      "local": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [] }, "updatedAt": 0 },
      "remote": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 1000 },
      "expected": "remote"
    },
    {
      "name": "an empty copy never erases the server's groups even when it is newer",
      "local": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [] }, "updatedAt": 100 },
      "remote": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 200 },
      "expected": "remote"
    },
    {
      "name": "a copy that declares it cleared its groups may replace one that has them",
      "local": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [], "groupsCleared": true }, "updatedAt": 200 },
      "remote": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 100 },
      "expected": "local"
    },
    {
      "name": "a cleared copy still loses to a newer grouped copy",
      "local": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [], "groupsCleared": true }, "updatedAt": 100 },
      "remote": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 200 },
      "expected": "remote"
    },
    {
      "name": "two blank copies have nothing to sync",
      "local": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [] }, "updatedAt": 0 },
      "remote": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [] }, "updatedAt": 0 },
      "expected": "none"
    },
    {
      "name": "a legacy copy with content beats an empty copy",
      "local": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 0 },
      "remote": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [] }, "updatedAt": 0 },
      "expected": "local"
    },
    {
      "name": "a legacy empty copy loses to a legacy copy with content",
      "local": { "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [] }, "updatedAt": 0 },
      "remote": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 0 },
      "expected": "remote"
    },
    {
      "name": "two copies with groups and the same timestamp keep the local one",
      "local": { "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] }, "updatedAt": 100 },
      "remote": { "data": { "groups": { "Other": ["local::b"] }, "collapsed": {}, "order": ["Other"], "ungroupedOrder": [] }, "updatedAt": 100 },
      "expected": "local"
    }
  ],
  "flagCases": [
    {
      "name": "a copy with one group has groups",
      "data": { "groups": { "Work": ["local::a"] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] },
      "hasGroups": true,
      "clearedGroups": false
    },
    {
      "name": "a group with no members still counts as a group",
      "data": { "groups": { "Work": [] }, "collapsed": {}, "order": ["Work"], "ungroupedOrder": [] },
      "hasGroups": true,
      "clearedGroups": false
    },
    {
      "name": "an empty copy has no groups",
      "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [] },
      "hasGroups": false,
      "clearedGroups": false
    },
    {
      "name": "a cleared copy has no groups but declares the erasure",
      "data": { "groups": {}, "collapsed": {}, "order": [], "ungroupedOrder": [], "groupsCleared": true },
      "hasGroups": false,
      "clearedGroups": true
    }
  ],
  "safeGroupNames": ["Work", "my group", "a-b_c", "Sprint 2"],
  "unsafeGroupNames": ["", "__proto__", "constructor", "prototype"]
}
